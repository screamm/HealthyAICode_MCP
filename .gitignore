# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
*.tsbuildinfo

# Environment
.env
.env.*
*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test / coverage
coverage/
.nyc_output/

# Caches
.turbo/
.cache/
.vitest/

# Code health cache
.healthy-ai-cache/

# Defects4J calibration cache (checkouts, labels, predictions, sweep results)
.calibration-cache/

# BugsInPy calibration data (manifest + fetched Python source files)
# Regenerated on demand by scripts/validation/python-calibration.mjs
benchmark-data/bugsinpy/

# TypeScript/JS calibration: raw cloned repos (large, re-cloned on demand)
# Results JSON is committed; raw repos are not.
benchmark-data/ts-calibration/raw-repos/

# Test fixtures temporary dirs
packages/core/tests/fixtures/project-*-tmp/

# Node module lock conflicts
.pnpm-lock-yaml.bak
*.bak

# Sprint / planning documents (generated by AI tooling)
docs/superpowers/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editors / IDE
# .vscode/mcp.json is intentionally tracked (VS Code MCP auto-config)
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
.vscode/*.code-workspace
.idea/
*.swp
*.swo
*~

# Downloaded analysis tool binaries (RefactoringMiner ~157MB, PMD, SpotBugs — re-downloaded on demand)
tools/

# Benchmark/calibration datasets (MLCQ, Defects4J — regenerated on demand)
benchmark-data/

# Field-test target repos (nested git clones)
field-repos/

# Holdout validation source repos (nested git clones)
holdout-src/

# OS crash dumps
*.stackdump

# Built VS Code extension package
vscode-extension/*.vsix

# Runtime telemetry output (generated during calibration runs, not a fixture)
packages/core/calibration-telemetry.jsonl
