{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Calibration thresholds for smell detectors",
  "type": "object",
  "properties": {
    "language": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "datasetVersion": { "type": "string" },
    "thresholds": {
      "type": "object",
      "properties": {
        "complexMethodThreshold": { "type": "number" },
        "criticalComplexityThreshold": { "type": "number" },
        "deepNestingThreshold": { "type": "number" },
        "highNestingThreshold": { "type": "number" },
        "criticalNestingThreshold": { "type": "number" },
        "largeMethodLines": { "type": "number" },
        "longParameterList": { "type": "number" },
        "cognitiveComplexityThreshold": { "type": "number" },
        "criticalCognitiveThreshold": { "type": "number" },
        "bumpyRoadChunkThreshold": { "type": "number" },
        "chainThreshold": { "type": "number" },
        "booleanChainThreshold": { "type": "number" },
        "atfdThreshold": { "type": "number" },
        "wmcThreshold": { "type": "number" },
        "largeFileLines": { "type": "number" }
      }
    },
    "weights": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "trainSize": { "type": "number" },
        "testSize": { "type": "number" },
        "f1Score": { "type": "number" },
        "aucScore": { "type": "number" },
        "baselineF1": { "type": "number" }
      }
    }
  }
}
